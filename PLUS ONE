class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;

        // Start from the last digit and move backwards
        for (int i = n - 1; i >= 0; i--) {
            // If the current digit is less than 9, just increment and return
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            
            // If the digit is 9, it becomes 0 and the carry continues to the next iteration
            digits[i] = 0;
        }

        // If all digits were 9 (e.g., [9, 9, 9]), we need a new array of size n + 1
        // By default in Java, all elements in a new int[] are initialized to 0
        int[] result = new int[n + 1];
        result[0] = 1; // Becomes [1, 0, 0, 0]
        return result;
    }
}
